                            (<t t-out="mail_tz or ''">America/Sao_Paulo</t>)
                        </div>
                    </t>
                </t>
            </div>
        </td>
        <td width="20px;" />
        <td style="padding-top: 5px;">
            <p style="margin: 0;"><strong>Detalhes do evento</strong></p>
            <ul style="margin-top: 8px;">
                <t t-if="object.location">
                    <li>Local: <t t-out="object.location or ''">Joinville</t>
                        (<a
                                            target="_blank"
                                            t-attf-href="http://maps.google.com/maps?oi=map&amp;q={{object.location}}"
                                            style="color: #009140;"
                                        >Ver no mapa</a>)
                    </li>
                </t>
                <t t-if="recurrent">
                    <li>Quando: <t
                                            t-out="object.recurrence_id.get_recurrence_name()"
                                        >A cada 1 semana, 3 eventos</t></li>
                </t>
                <t t-if="not object.allday and object.duration">
                    <li>Duração: <t
                                            t-out="('%dH%02d' % (object.duration, round(object.duration * 60) % 60)) or ''"
                                        >0H30</t></li>
                </t>
                <t t-if="object.videocall_location">
                    <li>
                        Como participar:
                        <t
                                            t-if="object.get_base_url() in object.videocall_location"
                                        > entre pelo Odoo Discuss</t>
                        <t t-else=""> entre em</t><br />
                        <a
                                            t-att-href="object.videocall_location"
                                            target="_blank"
                                            style="color: #009140;"
                                            t-out="object.videocall_location or ''"
                                        >www.mycompany.com/calendar/join_videocall/xyz</a>
                    </li>
                </t>
                <t t-if="not is_html_empty(object.description)">
                    <li>Descrição do evento:
                    <t t-out="object.description">Reunião interna.</t></li>
                </t>
            </ul>
        </td>
    </tr></table>
    <div class="user_input">
        <hr />
        <p placeholder="Escreva a sua mensagem aqui"><br /></p>
    </div>
</div>
        </field>
    </record>

    <!-- Same body in every installed language (the official pt_BR translation is empty) -->
    <function model="mail.template" name="_armazem_sync_calendar_translations" />

    <function model="ir.model.data" name="write">
        <value
            model="ir.model.data"
            search="[('module', '=', 'calendar'), ('name', 'in', ['calendar_template_meeting_invitation', 'calendar_template_meeting_changedate', 'calendar_template_meeting_reminder', 'calendar_template_meeting_update'])]"
        />
        <value eval="{'noupdate': True}" />
    </function>

</odoo>
