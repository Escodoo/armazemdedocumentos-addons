            </div>
            <div
                                style="color: #333333; text-align: center; font-size: 12px; font-weight: bold; border: 1px solid #009140; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px;"
                            >
                <t t-if="not object.event_id.allday">
                    <div>
                        <t
                                            t-out="format_time(time=object.event_id.start, tz=object.mail_tz, time_format='short', lang_code=object.env.lang) or ''"
                                        >11:00</t>
                    </div>
                    <t t-if="object.mail_tz">
                        <div style="font-size: 10px; font-weight: normal">
                            (<t t-out="object.mail_tz or ''">America/Sao_Paulo</t>)
                        </div>
                    </t>
                </t>
            </div>
        </td>
        <td width="20px;" />
        <td style="padding-top: 5px;">
            <p style="margin: 0;"><strong>Detalhes do evento</strong></p>
            <ul style="margin-top: 8px;">
                <t t-if="object.event_id.location">
                    <li>Local: <t t-out="object.event_id.location or ''">Joinville</t>
                        (<a
                                            target="_blank"
                                            t-attf-href="http://maps.google.com/maps?oi=map&amp;q={{object.event_id.location}}"
                                            style="color: #009140;"
                                        >Ver no mapa</a>)
                    </li>
                </t>
                <t t-if="recurrent">
                    <li>Quando: <t
                                            t-out="object.recurrence_id.get_recurrence_name()"
                                        >A cada 1 semana, 3 eventos</t></li>
                </t>
                <t t-if="not object.event_id.allday and object.event_id.duration">
                    <li>Duração: <t
                                            t-out="('%dH%02d' % (object.event_id.duration, round(object.event_id.duration * 60) % 60)) or ''"
                                        >0H30</t></li>
                </t>
                <li>Participantes
                <ul>
                    <li t-foreach="object.event_id.attendee_ids" t-as="attendee">
                        <div
                                                t-attf-style="display: inline-block; border-radius: 50%; width: 10px; height: 10px; background: {{ colors.get(attendee.state) or 'white' }};"
                                            > </div>
                        <t t-if="attendee.common_name != object.common_name">
                            <span
                                                    style="margin-left: 5px"
                                                    t-out="attendee.common_name or ''"
                                                >Mitchell Admin</span>
                        </t>
                        <t t-else="">
                            <span style="margin-left: 5px">Você</span>
                        </t>
                    </li>
                </ul></li>
                <t t-if="object.event_id.videocall_location">
                    <li>
                        Como participar:
                        <t
                                            t-if="object.get_base_url() in object.event_id.videocall_location"
                                        > entre pelo Odoo Discuss</t>
                        <t t-else=""> entre em</t><br />
                        <a
                                            t-att-href="object.event_id.videocall_location"
                                            target="_blank"
                                            style="color: #009140;"
                                            t-out="object.event_id.videocall_location or ''"
                                        >www.mycompany.com/calendar/join_videocall/xyz</a>
                    </li>
                </t>
                <t t-if="not is_html_empty(object.event_id.description)">
                    <li>Descrição do evento:
                    <t t-out="object.event_id.description">Reunião interna.</t></li>
                </t>
            </ul>
        </td>
    </tr></table>
    <p style="margin: 20px 0 0 0;">
        Atenciosamente,
        <t t-if="object.event_id.user_id.signature">
            <br />
            <t t-out="object.event_id.user_id.signature or ''">--<br
                            />Mitchell Admin</t>
        </t>
    </p>
</div>
        </field>
    </record>

    <record id="calendar.calendar_template_meeting_update" model="mail.template">
        <field name="subject">{{ object.name }}: atualização do evento</field>
        <field name="body_html" type="html">
<div>
    <t
