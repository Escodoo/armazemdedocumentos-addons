                                >4</t>
            </div>
            <div
                                style="font-size: 12px; text-align: center; font-weight: bold; color: #ffffff; background-color: #009140;"
                            >
                <t
                                    t-out="format_datetime(dt=object.start, tz=mail_tz if not object.allday else None, dt_format='MMMM y', lang_code=object.env.lang) or ''"
                                >maio 2021</t>
            </div>
            <div
                                style="color: #333333; text-align: center; font-size: 12px; font-weight: bold; border: 1px solid #009140; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px;"
                            >
                <t t-if="not object.allday">
                    <div>
                        <t
                                            t-out="format_time(time=object.start, tz=mail_tz, time_format='short', lang_code=object.env.lang) or ''"
