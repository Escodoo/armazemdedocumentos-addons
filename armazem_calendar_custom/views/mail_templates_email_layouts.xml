<odoo>

    <template id="mail_notification_calendar">
<html t-att-lang="lang">
<head>
    <meta http-equiv="Content-Type" content="text/html charset=UTF-8" />
</head>
<body>
<t t-set="subtype_internal" t-value="False" />
<t t-call="mail.notification_preview" />
<table
                    role="presentation"
                    width="100%"
                    cellpadding="0"
                    cellspacing="0"
                    border="0"
                    style="border-collapse: collapse; background-color: #f5f5f5; padding: 20px;"
                >
<tr><td align="center" style="padding: 20px 0;">
    <table
                                role="presentation"
                                width="600"
                                cellpadding="0"
                                cellspacing="0"
                                border="0"
                                style="border-collapse: separate; background-color: #ffffff; border-radius: 8px; box-shadow: 0 2px 4px #e5e5e5;"
                            >
        <!-- HEADER -->
        <tr>
            <td
                                        style="background-color: #ffffff; padding: 20px; text-align: center; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom: 4px solid #009140;"
                                    >
                <img
                                            t-att-src="'/logo.png?company=%s' % (company.id or 0)"
                                            t-att-alt="company.name"
                                            style="border-style: none; display: block; margin: 0 auto; max-width: 300px; width: auto; height: auto;"
                                        />
            </td>
        </tr>
        <!-- CONTENT -->
        <tr>
            <td
                                        style="padding: 30px; font-family: 'Lucida Grande', Helvetica, Verdana, Arial, sans-serif; font-size: 14px; line-height: 1.6; color: #333333;"
                                    >
                <t t-out="message.body" />
            </td>
        </tr>
        <!-- FOOTER -->
        <tr>
            <td
                                        style="background-color: #006B30; padding: 20px; text-align: center; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;"
                                    >
                <p
                                            style="margin: 0; font-family: 'Lucida Grande', Helvetica, Verdana, Arial, sans-serif; color: #ffffff; font-size: 12px; line-height: 1.5;"
                                        >
                    <span
                                                t-if="company.phone"
                                                style="display: inline-block; margin: 0 10px;"
                                                t-out="company.phone"
                                            />
                    <t t-if="company.phone and company.email"> | </t>
                    <span
                                                t-if="company.email"
                                                style="display: inline-block; margin: 0 10px;"
                                            >
                        <a
                                                    t-att-href="'mailto:%s' % company.email"
                                                    style="text-decoration: none; color: #ffffff;"
                                                    t-out="company.email"
                                                />
                    </span>
                    <t
                                                t-if="company.website and (company.phone or company.email)"
                                            > | </t>
                    <span
                                                t-if="company.website"
                                                style="display: inline-block; margin: 0 10px;"
                                            >
                        <a
                                                    t-att-href="company.website"
                                                    style="text-decoration: none; color: #ffffff;"
                                                    t-out="company.website.replace('https://', '').replace('http://', '')"
                                                />
                    </span>
                </p>
            </td>
        </tr>
    </table>
</td></tr>
</table>
</body>
</html>
    </template>

</odoo>
